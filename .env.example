# ---------------------------------------------------------------
# Copy to .env for local development. NEVER commit .env.
# ---------------------------------------------------------------

# --- Public (bundled into the browser; safe to expose) ---------
# Only VITE_* variables reach browser code. The anon key is public
# by design: Row Level Security in Supabase protects the data.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only secrets (used by /api functions) ---------------
# NEVER prefix these with VITE_ or they will be shipped to browsers.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=you@example.com
NOTIFY_EMAIL_FROM=Marvel Driving School <onboarding@resend.dev>
IP_HASH_SALT=change-me-to-a-long-random-string

# Optional: extra origins allowed to call /api (comma separated).
# The site's own domain is always allowed.
ALLOWED_ORIGINS=

# Optional: set to 1 to record analytics while running `npm run dev`
VITE_TRACK_IN_DEV=
